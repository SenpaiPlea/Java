<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="20" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.controller.GameController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <!-- TOP: Player Scores -->
    <HBox alignment="CENTER" spacing="50">
        <Label fx:id="player1ScoreLabel" text="Player 1: 0" />
        <Label fx:id="player2ScoreLabel" text="Player 2: 0" />
    </HBox>

    <!-- Current Player -->
    <Label fx:id="currentPlayerLabel" text="Current Player: Player 1" />

    <!-- Round Score -->
    <Label fx:id="roundScoreLabel" text="Round: 0" />

    <!-- Dice Image -->
    <ImageView fx:id="diceImageView" fitHeight="120" fitWidth="120" preserveRatio="true" />

    <!-- Roll Result Text -->
    <Label fx:id="resultLabel" text="Rolled: -" />

    <!-- Buttons -->
    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="rollButton" onAction="#onRollPressed" text="Roll" />
        <Button fx:id="hold" onAction="#onHoldPressed" text="Hold" />
        <Button onAction="#onMenuPressed" text="Back" />
    </HBox>

</VBox>
