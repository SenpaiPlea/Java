<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="randomCards.MainController"
      spacing="20"
      alignment="CENTER"
      style="-fx-padding: 20;">

    <HBox spacing="15" alignment="CENTER">
        <ImageView fx:id="card1" fitWidth="100" fitHeight="150"/>
        <ImageView fx:id="card2" fitWidth="100" fitHeight="150"/>
        <ImageView fx:id="card3" fitWidth="100" fitHeight="150"/>
        <ImageView fx:id="card4" fitWidth="100" fitHeight="150"/>
    </HBox>

    <Button fx:id="refreshButton" text="Refresh"/>
</VBox>
