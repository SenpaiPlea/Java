<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="conversionTool.MainController"
      alignment="CENTER" spacing="15">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Conversion Tool">
        <font><Font size="20"/></font>
    </Label>

    <HBox spacing="10" alignment="CENTER">
        <RadioButton fx:id="tempRadio" text="Celsius / Fahrenheit"/>
        <RadioButton fx:id="weightRadio" text="Pounds / Kilograms"/>
        <RadioButton fx:id="distanceRadio" text="Miles / Kilometers"/>
    </HBox>

    <GridPane hgap="10" vgap="10">
        <Label fx:id="label1" text="Value 1"/>
        <TextField fx:id="field1" GridPane.columnIndex="1"/>

        <Label fx:id="label2" text="Value 2" GridPane.rowIndex="1"/>
        <TextField fx:id="field2" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    </GridPane>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>
</VBox>
